# ==============================================================================
# SMART CAMPUS 360 – ENVIRONMENT CONFIGURATION
# ==============================================================================
# The application runs in dual mode:
# 1. Local Demonstration Mode: When VITE_SUPABASE_URL is omitted or set to placeholder,
#    the application automatically uses localStorage with rich pre-loaded college data.
# 2. Supabase Production Mode: When valid Supabase credentials are provided,
#    the application connects to your live Supabase PostgreSQL database.

# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Default College Name
VITE_CAMPUS_NAME="Apex Institute of Technology & Science"
